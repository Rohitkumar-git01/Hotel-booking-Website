# ---------------------------------------------------------------------------
# QuickStay API - environment variables
#
# Copy this file to `server/.env` and fill in the real values.
# `server/.env` is git ignored - never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Connection string of the MongoDB instance.
#   local : mongodb://127.0.0.1:27017/hotel-booking
#   Atlas : mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_URI=mongodb://127.0.0.1:27017/hotel-booking

# Name of the database that is actually used. It is pinned so that a URI
# without a path (the usual Atlas format) still uses the right database.
# The test suite overrides this with "quickstay-test".
MONGODB_DB_NAME=hotel-booking

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma separated list of frontend origins that may call this API.
# Leave empty for local development (the API stays open).
# Production example: https://quickstay.vercel.app,https://www.quickstay.app
CLIENT_URL=http://localhost:5173

# Set to 1 to skip the demo seed data (used by the test suite).
SKIP_SEED=0

# --- Clerk (authentication) -------------------------------------------------
# Publishable key of the Clerk instance (safe to expose, only the secret key
# is sensitive).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Issuer of the Clerk JWTs. Usually https://<your-domain>.clerk.accounts.dev
CLERK_ISSUER=

# Secret of the Clerk webhook endpoint (user create/update events).
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Roles ------------------------------------------------------------------
# Comma separated list of Clerk user ids that are promoted to the "admin" role
# during the user sync. Example: user_2abcDEF,user_2ghiJKL
ADMIN_USER_IDS=

# --- Approval workflow ------------------------------------------------------
# Set to 0 to keep an approved listing approved when the owner edits it.
# Default (1): material edits send the listing back to "pending".
HOTEL_EDITS_REQUIRE_REAPPROVAL=1

# --- Cloudinary (image storage) --------------------------------------------
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Geocoding (OpenStreetMap Nominatim proxy) -----------------------------
# Descriptive User-Agent, required by the Nominatim usage policy.
GEOCODER_USER_AGENT=QuickStay/1.0 (contact: you@example.com)
# Optional: your domain, sent as the Referer header.
GEOCODER_CONTACT=
# Optional: self hosted Nominatim instance.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# --- Chatbot ---------------------------------------------------------------
GEMINI_API_KEY=

# --- Tests (optional) -------------------------------------------------------
# The test suite always uses its own throw-away database.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/quickstay-test
# MONGODB_DB_NAME_TEST=quickstay-test
# Set to 1 to allow running the tests against a remote database.
# ALLOW_REMOTE_TEST_DB=0
