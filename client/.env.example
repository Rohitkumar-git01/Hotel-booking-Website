# ---------------------------------------------------------------------------
# QuickStay frontend - environment variables
#
# Copy this file to `client/.env` and fill in the real values.
# `client/.env` is git ignored - never commit real credentials.
# ---------------------------------------------------------------------------

# Publishable key of the Clerk instance. It is embedded in the bundle, so only
# ever use the publishable key here (pk_... / pk_test_...).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# URL of the backend API.
#   local development : http://localhost:3000
#   production        : https://your-api-domain.vercel.app
VITE_BACKEND_URL=http://localhost:3000

# --- Map tiles (optional) ---------------------------------------------------
# OpenStreetMap is used by default. Change the tile server and the attribution
# together - the attribution is required by the tile usage policy.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
